# 沙箱配置
SANDBOX_HOST=0.0.0.0
SANDBOX_PORT=8001
WORKSPACE_DIR=./sandbox/workspace

# Python 沙箱API
PYTHON_SANDBOX_URL=http://localhost:8000

# 数据库
SQLITE_PATH=./sandbox/data/sandbox.db
REDIS_URL=redis://localhost:6379

# 浏览器引擎
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PLAYWRIGHT_BROWSERS_PATH=/usr/lib/chromium

# MCP 服务器
MCP_TRANSPORT=stdio

# 日志
LOG_LEVEL=info
LOG_DIR=./sandbox/logs

# LaTeX
LATEX_ENGINE=xelatex
