      <data key="description">戊戌变法是救亡图存的资产阶级改良运动；义和团运动打击列强瓜分图谋。</data>
      <data key="keywords">戊戌变法,义和团,救亡图存,改良运动</data>
      <data key="exam_type">选择题</data>
      <data key="importance">3</data>
      <data key="textbook_source">纲要上 第十八课</data>
    </node>
    <node id="H_K1_6_5">
      <data key="name">辛亥革命</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">历史</data>
      <data key="module">中外历史纲要(上)——中国史</data>
      <data key="chapter">晚清至民国（救亡图存与革命）</data>
      <data key="difficulty">5</data>
      <data key="description">武昌起义推翻清王朝；颁布《中华民国临时约法》（中国第一部资产阶级宪法）；终结君主专制但未改变社会性质。</data>
      <data key="keywords">辛亥革命,武昌起义,临时约法,推翻君主专制,资产阶级革命</data>
      <data key="exam_type">材料分析题、论述题</data>
      <data key="importance">5</data>
      <data key="textbook_source">纲要上 第十九课</data>
    </node>
    <node id="H_K1_6_6">
