    <node id="K6">
      <data key="name">氧化剂与还原剂</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">化学</data>
      <data key="module">必修第一册(无机基础)</data>
      <data key="chapter">物质及其变化</data>
      <data key="difficulty">4</data>
      <data key="description">理解氧化剂与还原剂的概念,掌握常见的氧化剂与还原剂及氧化还原反应的规律。</data>
      <data key="keywords">氧化剂,还原剂,氧化性还原性,常见试剂</data>
      <data key="exam_type">选择题,判断题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修第一册</data>
    </node>
