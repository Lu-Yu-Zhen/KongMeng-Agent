      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">神经调节</data>
      <data key="difficulty">5</data>
      <data key="description">掌握突触的结构(突触前膜、突触间隙、突触后膜)及兴奋在突触处的传递过程(电信号→化学信号→电信号)，理解单向传递的原因和神经递质的作用。</data>
      <data key="keywords">突触,突触前膜,突触间隙,突触后膜,神经递质,单向传递</data>
      <data key="exam_type">选择题,综合分析,过程图解</data>
      <data key="importance">5</data>
      <data key="textbook_source">选择性必修1</data>
    </node>
    <node id="K55">
      <data key="name">神经系统的分级调节</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">神经调节</data>
      <data key="difficulty">4</data>
      <data key="description">理解中枢神经系统各部位的分工(大脑皮层、小脑、脑干、脊髓)及分级调节的关系，掌握大脑皮层作为最高级中枢的功能。</data>
      <data key="keywords">分级调节,大脑皮层,小脑,脑干,脊髓,高级中枢</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选择性必修1</data>
    </node>
    <node id="K56">
      <data key="name">激素调节的原理</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">体液调节</data>
      <data key="difficulty">4</data>
      <data key="description">理解激素调节的概念和特点(微量高效、通过体液运输、作用于靶器官靶细胞)，掌握激素间的协同与拮抗作用。</data>
      <data key="keywords">激素调节,微量高效,靶器官,靶细胞,协同作用,拮抗作用</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选择性必修1</data>
    </node>
    <node id="K57">
      <data key="name">主要激素及其作用</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">体液调节</data>
      <data key="difficulty">4</data>
      <data key="description">掌握甲状腺激素、胰岛素与胰高血糖素、生长激素、性激素等主要激素的分泌部位、生理作用及分泌异常的表现。</data>
      <data key="keywords">甲状腺激素,胰岛素,胰高血糖素,生长激素,性激素,分泌异常</data>
      <data key="exam_type">选择题,综合分析</data>
      <data key="importance">5</data>
      <data key="textbook_source">选择性必修1</data>
    </node>
    <node id="K58">
      <data key="name">神经调节与体液调节的关系</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">体液调节</data>
      <data key="difficulty">4</data>
      <data key="description">理解神经调节与体液调节的区别与联系，掌握两者协调维持稳态的实例(血糖调节、体温调节、水盐调节)。</data>
      <data key="keywords">神经调节,体液调节,血糖调节,体温调节,水盐调节,协调</data>
      <data key="exam_type">选择题,综合分析</data>
      <data key="importance">4</data>
      <data key="textbook_source">选择性必修1</data>
    </node>
    <node id="K59">
      <data key="name">免疫系统的组成</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">免疫调节</data>
      <data key="difficulty">3</data>
      <data key="description">掌握免疫器官(骨髓、胸腺、脾、淋巴结)、免疫细胞(淋巴细胞、吞噬细胞)和免疫活性物质(抗体、淋巴因子、溶菌酶)的组成。</data>
      <data key="keywords">免疫器官,免疫细胞,淋巴细胞,吞噬细胞,抗体,淋巴因子</data>
      <data key="exam_type">选择题,判断题</data>
      <data key="importance">3</data>
      <data key="textbook_source">选择性必修1</data>
    </node>
    <node id="K60">
      <data key="name">特异性免疫</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">免疫调节</data>
      <data key="difficulty">5</data>
      <data key="description">掌握体液免疫(B细胞→浆细胞→抗体)和细胞免疫(T细胞→效应T细胞→裂解靶细胞)的过程及两者的协同关系，理解记忆细胞的功能。</data>
      <data key="keywords">体液免疫,细胞免疫,B细胞,浆细胞,抗体,效应T细胞,记忆细胞</data>
      <data key="exam_type">选择题,综合分析,过程图解</data>
      <data key="importance">5</data>
      <data key="textbook_source">选择性必修1</data>
    </node>
    <node id="K61">
      <data key="name">免疫失调</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">免疫调节</data>
      <data key="difficulty">3</data>
      <data key="description">理解过敏反应(已免疫机体再次接触相同抗原)、自身免疫病(免疫系统攻击自身组织)和免疫缺陷病(艾滋病AIDS)的机制。</data>
      <data key="keywords">过敏反应,自身免疫病,免疫缺陷病,艾滋病,过敏原</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">3</data>
      <data key="textbook_source">选择性必修1</data>
    </node>
    <node id="K62">
      <data key="name">生长素的发现与作用</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">植物激素调节</data>
      <data key="difficulty">4</data>
      <data key="description">了解生长素的发现历程(达尔文、詹森、拜耳、温特)，掌握生长素的产生(幼嫩芽叶)、运输(极性运输)和分布，理解两重性(低促高抑)。</data>
      <data key="keywords">生长素,达尔文,温特,极性运输,两重性,顶端优势</data>
      <data key="exam_type">选择题,实验分析,综合题</data>
      <data key="importance">5</data>
      <data key="textbook_source">选择性必修1</data>
    </node>
    <node id="K63">
      <data key="name">其他植物激素</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">植物激素调节</data>
      <data key="difficulty">3</data>
      <data key="description">掌握赤霉素、细胞分裂素、脱落酸和乙烯的主要生理作用，理解植物激素间的协同与拮抗关系。</data>
      <data key="keywords">赤霉素,细胞分裂素,脱落酸,乙烯,协同,拮抗</data>
      <data key="exam_type">选择题,判断题</data>
      <data key="importance">3</data>
      <data key="textbook_source">选择性必修1</data>
