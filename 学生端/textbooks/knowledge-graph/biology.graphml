      <data key="module">必修1 分子与细胞</data>
      <data key="chapter">细胞中的元素与化合物</data>
      <data key="difficulty">3</data>
      <data key="description">区分自由水与结合水的功能差异，理解自由水/结合水比值与代谢速率、抗逆性的关系。</data>
      <data key="keywords">自由水,结合水,代谢,抗逆性,比值</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">4</data>
