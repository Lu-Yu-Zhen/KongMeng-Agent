    <node id="K42">
      <data key="name">基因突变</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因突变及其他变异</data>
      <data key="difficulty">4</data>
      <data key="description">掌握基因突变的概念(DNA碱基对的增添、缺失、替换)、特点(普遍性、随机性、低频性、不定向性、多害少利性)及意义(生物变异的根本来源)。</data>
      <data key="keywords">基因突变,碱基对,增添,缺失,替换,变异来源</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K43">
      <data key="name">基因重组</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因突变及其他变异</data>
      <data key="difficulty">4</data>
      <data key="description">理解基因重组的类型(自由组合型、交叉互换型)及发生在减数分裂过程中的机制，掌握其作为有性生殖变异来源的意义。</data>
      <data key="keywords">基因重组,自由组合,交叉互换,减数分裂,有性生殖</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K44">
      <data key="name">染色体变异</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因突变及其他变异</data>
      <data key="difficulty">5</data>
      <data key="description">掌握染色体结构变异(缺失、重复、倒位、易位)和数目变异(整倍体、非整倍体)的类型，理解单倍体、二倍体、多倍体的概念与育种应用。</data>
      <data key="keywords">染色体结构变异,染色体数目变异,单倍体,多倍体,缺失,重复,倒位,易位</data>
