      <data key="module">选择性必修2 生物与环境</data>
      <data key="chapter">群落及其演替</data>
      <data key="difficulty">4</data>
      <data key="description">掌握群落的物种组成(优势种)、垂直结构(分层现象)和水平结构，理解种间关系(竞争、捕食、互利共生、寄生)及生态位概念。</data>
      <data key="keywords">群落,优势种,垂直结构,水平结构,种间关系,生态位</data>
      <data key="exam_type">选择题,综合分析</data>
      <data key="importance">4</data>
      <data key="textbook_source">选择性必修2</data>
