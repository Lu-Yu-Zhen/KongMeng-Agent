    <node id="K78">
      <data key="name">植物细胞工程</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修3 生物技术与工程</data>
      <data key="chapter">细胞工程</data>
      <data key="difficulty">4</data>
      <data key="description">掌握植物组织培养(脱分化→愈伤组织→再分化→试管苗)的原理(全能性)和植物体细胞杂交(去壁、融合、筛选)的技术过程。</data>
      <data key="keywords">植物组织培养,脱分化,愈伤组织,再分化,体细胞杂交,原生质体</data>
      <data key="exam_type">选择题,综合分析</data>
      <data key="importance">4</data>
      <data key="textbook_source">选择性必修3</data>
    </node>
    <node id="K79">
      <data key="name">动物细胞工程</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修3 生物技术与工程</data>
      <data key="chapter">细胞工程</data>
      <data key="difficulty">5</data>
      <data key="description">掌握动物细胞培养技术、细胞融合和单克隆抗体制备(杂交瘤细胞:筛选→克隆→抗体)的原理与应用。</data>
      <data key="keywords">动物细胞培养,细胞融合,单克隆抗体,杂交瘤细胞,HAT筛选</data>
      <data key="exam_type">选择题,综合分析,过程图解</data>
      <data key="importance">5</data>
      <data key="textbook_source">选择性必修3</data>
    </node>
    <node id="K80">
      <data key="name">DNA重组技术的基本工具</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修3 生物技术与工程</data>
      <data key="chapter">基因工程</data>
      <data key="difficulty">4</data>
      <data key="description">掌握限制性内切核酸酶(识别特定序列、切割产生黏性末端或平末端)、DNA连接酶和运载体(质粒)的作用与特点。</data>
      <data key="keywords">限制酶,DNA连接酶,运载体,质粒,黏性末端,平末端</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选择性必修3</data>
    </node>
    <node id="K81">
      <data key="name">基因工程的操作程序</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修3 生物技术与工程</data>
      <data key="chapter">基因工程</data>
      <data key="difficulty">5</data>
      <data key="description">掌握基因工程四步操作:目的基因的获取(PCR、人工合成)、表达载体的构建、导入受体细胞、目的基因的检测与鉴定。</data>
      <data key="keywords">目的基因,PCR,表达载体,导入,检测鉴定,基因工程</data>
      <data key="exam_type">选择题,综合分析,排序题</data>
      <data key="importance">5</data>
      <data key="textbook_source">选择性必修3</data>
    </node>
    <node id="K82">
      <data key="name">基因工程的应用</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修3 生物技术与工程</data>
      <data key="chapter">基因工程</data>
      <data key="difficulty">3</data>
      <data key="description">了解基因工程在农牧业(抗虫棉)、医药(胰岛素、干扰素)和环境保护(工程菌降解污染物)中的应用实例。</data>
      <data key="keywords">抗虫棉,胰岛素,干扰素,工程菌,基因工程应用</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">3</data>
      <data key="textbook_source">选择性必修3</data>
    </node>
    <node id="K83">
      <data key="name">体内受精与早期胚胎发育</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修3 生物技术与工程</data>
      <data key="chapter">胚胎工程</data>
      <data key="difficulty">3</data>
      <data key="description">掌握受精过程(精子获能、顶体反应、透明带反应、卵黄膜封闭作用)及早期胚胎发育阶段(桑椹胚、囊胚、原肠胚)。</data>
      <data key="keywords">受精,精子获能,顶体反应,桑椹胚,囊胚,原肠胚</data>
      <data key="exam_type">选择题,综合分析</data>
      <data key="importance">3</data>
      <data key="textbook_source">选择性必修3</data>
    </node>
    <node id="K84">
      <data key="name">胚胎工程的应用</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修3 生物技术与工程</data>
      <data key="chapter">胚胎工程</data>
      <data key="difficulty">4</data>
      <data key="description">掌握体外受精技术(卵母细胞采集、精子获能、受精)、胚胎移植(供体超数排卵、胚胎收集与移植)和胚胎分割的技术过程与意义。</data>
      <data key="keywords">体外受精,胚胎移植,超数排卵,胚胎分割,试管动物</data>
      <data key="exam_type">选择题,综合分析</data>
      <data key="importance">4</data>
      <data key="textbook_source">选择性必修3</data>
    </node>
