      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因的表达</data>
      <data key="difficulty">3</data>
      <data key="description">理解密码子的概念(64种，其中61种编码氨基酸，3种终止密码子)，掌握密码子的简并性、通用性与不重叠性。</data>
      <data key="keywords">密码子,简并性,通用性,终止密码子,起始密码子</data>
      <data key="exam_type">选择题,判断题</data>
      <data key="importance">3</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K41">
      <data key="name">中心法则</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因的表达</data>
      <data key="difficulty">4</data>
      <data key="description">掌握中心法则的内容(复制、转录、翻译)及其补充(逆转录、RNA复制)，理解各类生物信息传递的特点。</data>
      <data key="keywords">中心法则,复制,转录,翻译,逆转录,RNA复制</data>
      <data key="exam_type">选择题,综合分析</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修2</data>
