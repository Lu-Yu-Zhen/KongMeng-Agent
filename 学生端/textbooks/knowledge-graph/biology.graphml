      <data key="chapter">细胞的生命历程</data>
      <data key="difficulty">4</data>
      <data key="description">理解癌细胞的主要特征(无限增殖、形态结构改变、表面发生变化)，掌握致癌因子(物理、化学、病毒)及原癌基因与抑癌基因的作用。</data>
      <data key="keywords">癌细胞,无限增殖,原癌基因,抑癌基因,致癌因子</data>
      <data key="exam_type">选择题,综合分析</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1</data>
    </node>
    <node id="K30">
      <data key="name">孟德尔杂交实验</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">遗传因子的发现</data>
      <data key="difficulty">3</data>
      <data key="description">了解孟德尔选用豌豆的原因(自花传粉、相对性状明显)，掌握一对相对性状杂交实验的过程与现象(F1全显、F2 3:1分离比)。</data>
      <data key="keywords">豌豆,相对性状,杂交,F1,F2,3:1</data>
      <data key="exam_type">选择题,实验分析</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K31">
      <data key="name">分离定律</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">遗传因子的发现</data>
      <data key="difficulty">5</data>
      <data key="description">掌握分离定律的实质(等位基因随同源染色体分离而分开)，能进行遗传概率计算(棋盘法、分支法)，能判断显隐性关系与基因型。</data>
      <data key="keywords">分离定律,等位基因,同源染色体,概率计算,基因型推断</data>
      <data key="exam_type">计算题,选择题,综合题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K32">
      <data key="name">自由组合定律</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">遗传因子的发现</data>
      <data key="difficulty">5</data>
      <data key="description">掌握自由组合定律的实质(非同源染色体上非等位基因自由组合)，能进行多对基因遗传概率计算(9:3:3:1及其变式)。</data>
      <data key="keywords">自由组合定律,非同源染色体,非等位基因,9:3:3:1,变式比例</data>
      <data key="exam_type">计算题,选择题,综合题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K33">
      <data key="name">减数分裂</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因与染色体的关系</data>
      <data key="difficulty">5</data>
      <data key="description">掌握减数第一次分裂(同源染色体分离)和减数第二次分裂(着丝粒分裂)的过程，理解联会、四分体、交叉互换的意义，能比较有丝分裂与减数分裂。</data>
      <data key="keywords">减数分裂,同源染色体,联会,四分体,交叉互换,减I,减II</data>
      <data key="exam_type">选择题,综合分析,曲线题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K34">
      <data key="name">基因在染色体上</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因与染色体的关系</data>
      <data key="difficulty">4</data>
      <data key="description">理解萨顿假说(基因和染色体行为存在平行关系)和摩尔根果蝇实验证据，掌握基因在染色体上呈线性排列的结论。</data>
      <data key="keywords">萨顿假说,摩尔根,果蝇,白眼基因,线性排列</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K35">
      <data key="name">伴性遗传</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因与染色体的关系</data>
      <data key="difficulty">5</data>
      <data key="description">掌握伴X染色体隐性遗传(色盲、血友病)、显性遗传和伴Y遗传的特点及判断方法，能进行家系图分析和概率计算。</data>
      <data key="keywords">伴性遗传,X染色体,色盲,血友病,家系分析,概率</data>
      <data key="exam_type">家系分析题,选择题,计算题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K36">
      <data key="name">DNA是主要遗传物质</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因的本质</data>
      <data key="difficulty">4</data>
      <data key="description">掌握肺炎双球菌转化实验(格里菲思、艾弗里)和噬菌体侵染细菌实验(赫尔希、蔡斯)的原理与结论，理解DNA是遗传物质而RNA病毒以RNA为遗传物质。</data>
      <data key="keywords">肺炎双球菌,转化实验,噬菌体侵染,DNA,遗传物质</data>
      <data key="exam_type">选择题,实验分析</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K37">
      <data key="name">DNA分子结构</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因的本质</data>
      <data key="difficulty">4</data>
      <data key="description">掌握DNA双螺旋结构(沃森、克里克)的特点:两条链反向平行、磷酸脱氧核糖交替连接、碱基互补配对(A-T、G-C)，理解碱基计算规律。</data>
      <data key="keywords">双螺旋,反向平行,碱基互补配对,A-T,G-C,碱基计算</data>
      <data key="exam_type">选择题,计算题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K38">
      <data key="name">DNA复制</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因的本质</data>
      <data key="difficulty">4</data>
      <data key="description">掌握DNA复制的时期(S期)、方式(半保留复制)、条件(模板、原料、酶、能量)和过程(解旋、合成)，能分析梅塞尔森-斯塔尔实验。</data>
      <data key="keywords">半保留复制,解旋酶,DNA聚合酶,S期,梅塞尔森实验</data>
      <data key="exam_type">选择题,实验分析,综合题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K39">
      <data key="name">转录与翻译</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">必修2 遗传与进化</data>
      <data key="chapter">基因的表达</data>
      <data key="difficulty">5</data>
      <data key="description">掌握转录(DNA→mRNA，场所为细胞核)和翻译(mRNA→蛋白质，场所为核糖体)的过程，理解tRNA的反密码子识别及氨基酸的连接。</data>
      <data key="keywords">转录,翻译,mRNA,tRNA,核糖体,密码子,反密码子</data>
      <data key="exam_type">选择题,综合分析,过程图解</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2</data>
    </node>
    <node id="K40">
