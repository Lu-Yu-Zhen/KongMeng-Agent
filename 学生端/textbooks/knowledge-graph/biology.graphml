    <node id="K64">
      <data key="name">植物激素的应用</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修1 稳态与调节</data>
      <data key="chapter">植物激素调节</data>
      <data key="difficulty">3</data>
      <data key="description">掌握植物生长调节剂在农业生产中的应用实例(无子果实、催熟、除草等)，理解合理使用植物激素的意义。</data>
      <data key="keywords">植物生长调节剂,无子果实,催熟,除草,农业应用</data>
      <data key="exam_type">选择题,应用题</data>
      <data key="importance">3</data>
      <data key="textbook_source">选择性必修1</data>
