    <node id="K65">
      <data key="name">种群特征</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修2 生物与环境</data>
      <data key="chapter">种群及其动态</data>
      <data key="difficulty">3</data>
      <data key="description">掌握种群的数量特征(种群密度、出生率死亡率、年龄结构、性别比例)和空间特征(均匀分布、随机分布、集群分布)。</data>
      <data key="keywords">种群密度,出生率,死亡率,年龄结构,性别比例,空间特征</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选择性必修2</data>
    </node>
    <node id="K66">
      <data key="name">种群数量变化</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">生物</data>
      <data key="module">选择性必修2 生物与环境</data>
      <data key="chapter">种群及其动态</data>
      <data key="difficulty">5</data>
      <data key="description">掌握J型曲线(理想条件:λ)和S型曲线(有限环境:K值)的数学模型，理解K值与K/2的实践意义(渔业捕捞、害虫防治)。</data>
      <data key="keywords">J型曲线,S型曲线,K值,K/2,种群增长,数学模型</data>
      <data key="exam_type">选择题,曲线分析,计算题</data>
      <data key="importance">5</data>
      <data key="textbook_source">选择性必修2</data>
    </node>
    <node id="K67">
