      <data key="module">选择性必修2 生物与环境</data>
      <data key="chapter">群落及其演替</data>
      <data key="difficulty">3</data>
      <data key="description">区分初生演替(从无到有，如火山岩、沙丘)和次生演替(原有土壤条件保留，如火灾后)的特点与过程。</data>
      <data key="keywords">初生演替,次生演替,火山岩,沙丘,火灾后</data>
      <data key="exam_type">选择题,分析题</data>
      <data key="importance">3</data>
      <data key="textbook_source">选择性必修2</data>
