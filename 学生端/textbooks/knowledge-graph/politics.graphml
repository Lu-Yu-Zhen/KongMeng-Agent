      <data key="difficulty">4</data>
      <data key="description">劳动合同的订立、变更、解除；劳动者享有平等就业、取得报酬、休息休假、社会保险等权利。</data>
      <data key="keywords">劳动合同,订立解除,劳动者权利,劳动报酬</data>
      <data key="exam_type">案例分析题、选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选必2 第三单元</data>
    </node>
    <node id="P_K6_2_4">
      <data key="name">争议解决方式</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">法律生活与逻辑思维</data>
      <data key="chapter">家庭婚姻就业与争议解决</data>
      <data key="difficulty">3</data>
      <data key="description">协商、调解、仲裁、诉讼；区分民事仲裁（或裁或审）与劳动仲裁（仲裁前置）。</data>
      <data key="keywords">争议解决,协商调解仲裁诉讼,劳动仲裁前置</data>
      <data key="exam_type">选择题、案例分析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选必2 第四单元</data>
    </node>
    <node id="P_K6_3_1">
      <data key="name">科学思维的特征与意义</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">法律生活与逻辑思维</data>
      <data key="chapter">科学思维与形式逻辑</data>
      <data key="difficulty">2</data>
      <data key="description">科学思维具有客观性、预见性、可检验性；有助于把握事物本质、推动认识和实践创新。</data>
      <data key="keywords">科学思维,客观性,预见性,可检验性</data>
      <data key="exam_type">选择题</data>
      <data key="importance">3</data>
      <data key="textbook_source">选必3 第一单元</data>
    </node>
    <node id="P_K6_3_2">
      <data key="name">概念的内涵与外延</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">法律生活与逻辑思维</data>
      <data key="chapter">科学思维与形式逻辑</data>
      <data key="difficulty">3</data>
      <data key="description">概念的内涵是事物的特有属性，外延是概念所指对象范围；概念间有全同、属种、交叉、矛盾、反对等关系。</data>
      <data key="keywords">概念,内涵,外延,概念间关系</data>
      <data key="exam_type">选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选必3 第二单元</data>
    </node>
    <node id="P_K6_3_3">
      <data key="name">简单判断</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">法律生活与逻辑思维</data>
      <data key="chapter">科学思维与形式逻辑</data>
      <data key="difficulty">3</data>
      <data key="description">包括性质判断（单称、特称、全称；肯定否定）和关系判断。</data>
      <data key="keywords">性质判断,关系判断,单称特称全称</data>
      <data key="exam_type">选择题</data>
      <data key="importance">3</data>
      <data key="textbook_source">选必3 第二单元</data>
    </node>
    <node id="P_K6_3_4">
      <data key="name">复合判断</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">法律生活与逻辑思维</data>
      <data key="chapter">科学思维与形式逻辑</data>
      <data key="difficulty">3</data>
      <data key="description">联言判断、选言判断（相容不相容）、假言判断（充分必要条件）。</data>
      <data key="keywords">联言判断,选言判断,假言判断,充分必要条件</data>
      <data key="exam_type">选择题、案例分析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选必3 第二单元</data>
    </node>
    <node id="P_K6_3_5">
      <data key="name">形式逻辑的基本规律</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">法律生活与逻辑思维</data>
      <data key="chapter">科学思维与形式逻辑</data>
      <data key="difficulty">4</data>
      <data key="description">同一律（思想确定性）、矛盾律（不可同真）、排中律（不可同假），是正确思维的必要条件。</data>
      <data key="keywords">同一律,矛盾律,排中律,思维规律</data>
      <data key="exam_type">选择题、辨析题</data>
      <data key="importance">5</data>
      <data key="textbook_source">选必3 第二单元</data>
    </node>
    <node id="P_K6_3_6">
