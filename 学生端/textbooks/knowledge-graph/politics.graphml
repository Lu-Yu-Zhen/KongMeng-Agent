      <data key="subject">政治</data>
      <data key="module">中国特色社会主义</data>
      <data key="chapter">新时代中国特色社会主义与中国梦</data>
      <data key="difficulty">2</data>
      <data key="description">中国梦的本质是国家富强、民族振兴、人民幸福；实现中国梦必须走中国道路、弘扬中国精神、凝聚中国力量。</data>
      <data key="keywords">中国梦,国家富强,民族振兴,人民幸福</data>
