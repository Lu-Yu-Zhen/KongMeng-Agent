      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">中国特色社会主义</data>
      <data key="chapter">新时代中国特色社会主义与中国梦</data>
      <data key="difficulty">4</data>
      <data key="description">新时代我国社会主要矛盾已转化为人民日益增长的美好生活需要和不平衡不充分的发展之间的矛盾。</data>
      <data key="keywords">社会主要矛盾,美好生活需要,不平衡不充分</data>
      <data key="exam_type">材料分析题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修1 第三课</data>
    </node>
    <node id="P_K1_3_2">
