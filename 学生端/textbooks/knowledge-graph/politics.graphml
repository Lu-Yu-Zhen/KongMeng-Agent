    <node id="P_K1_2_4">
      <data key="name">中国特色社会主义理论体系</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">中国特色社会主义</data>
      <data key="chapter">中国特色社会主义的开创与发展</data>
      <data key="difficulty">4</data>
      <data key="description">包括邓小平理论、三个代表重要思想、科学发展观、习近平新时代中国特色社会主义思想，是马克思主义中国化的成果。</data>
      <data key="keywords">理论体系,三个代表,科学发展观,马克思主义中国化</data>
