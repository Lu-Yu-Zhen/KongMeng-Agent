      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">联系发展矛盾（唯物辩证法）</data>
      <data key="difficulty">4</data>
      <data key="description">矛盾的两个基本属性：同一性指矛盾双方相互依存相互转化，斗争性指双方相互排斥相互对立。</data>
      <data key="keywords">矛盾,同一性,斗争性,基本属性</data>
