      <data key="chapter">联系发展矛盾（唯物辩证法）</data>
      <data key="difficulty">4</data>
      <data key="description">主要矛盾决定事物发展进程，矛盾主要方面决定事物性质；坚持两点论与重点论统一。</data>
      <data key="keywords">主要矛盾,次要矛盾,矛盾主要方面,两点论重点论</data>
      <data key="exam_type">选择题、材料分析题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修4 第七课</data>
    </node>
    <node id="P_K4_3_7">
