      <data key="module">政治与法治</data>
      <data key="chapter">全面依法治国</data>
      <data key="difficulty">3</data>
      <data key="description">宪法具有最高法律效力，坚持依法治国首先要坚持依宪治国，依法执政首先要依宪执政。</data>
      <data key="keywords">宪法,根本法,依宪治国,依宪执政</data>
