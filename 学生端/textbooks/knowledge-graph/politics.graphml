    <node id="P_K4_1_1">
      <data key="name">哲学是世界观与方法论的统一</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">时代精神的精华</data>
      <data key="difficulty">2</data>
      <data key="description">哲学是关于世界观的学问，是系统化理论化的世界观，又是人们认识和改造世界的世界观方法论。</data>
      <data key="keywords">哲学,世界观,方法论,统一</data>
      <data key="exam_type">选择题</data>
      <data key="importance">3</data>
      <data key="textbook_source">必修4 第一课</data>
    </node>
    <node id="P_K4_1_2">
      <data key="name">哲学的基本问题</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">时代精神的精华</data>
      <data key="difficulty">4</data>
      <data key="description">思维和存在的关系问题是哲学基本问题，包括何者为本原（第一性）和能否同一（可知论不可知论）两方面。</data>
      <data key="keywords">哲学基本问题,思维与存在,第一性,可知论</data>
      <data key="exam_type">选择题、辨析题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修4 第一课</data>
    </node>
    <node id="P_K4_1_3">
      <data key="name">唯物主义与唯心主义的分歧</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">时代精神的精华</data>
      <data key="difficulty">3</data>
      <data key="description">围绕物质和意识何者为本原，形成唯物主义（物质本原）与唯心主义（意识本原）两大基本派别。</data>
      <data key="keywords">唯物主义,唯心主义,基本派别,本原</data>
      <data key="exam_type">选择题、辨析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修4 第一课</data>
    </node>
    <node id="P_K4_1_4">
      <data key="name">马克思主义哲学的产生与特征</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">时代精神的精华</data>
      <data key="difficulty">3</data>
      <data key="description">以实践为基础的科学性和革命性的统一，实现了唯物主义与辩证法、唯物辩证的自然观与历史观有机统一。</data>
      <data key="keywords">马克思主义哲学,实践性,科学性,革命性</data>
      <data key="exam_type">选择题、简答题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修4 第一课</data>
    </node>
    <node id="P_K4_2_1">
      <data key="name">世界的物质性</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">探索世界与追求真理</data>
      <data key="difficulty">3</data>
      <data key="description">物质是不依赖于人的意识并能为人的意识所反映的客观实在；世界的真正统一性在于物质性。</data>
      <data key="keywords">物质,客观实在,物质性,物质决定意识</data>
      <data key="exam_type">选择题、辨析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修4 第二课</data>
    </node>
    <node id="P_K4_2_2">
      <data key="name">意识的本质与作用</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">探索世界与追求真理</data>
      <data key="difficulty">4</data>
      <data key="description">意识是物质世界长期发展的产物，是人脑的机能，是客观存在的反映；意识具有能动作用（能动认识世界和改造世界）。</data>
      <data key="keywords">意识,人脑机能,客观反映,能动作用</data>
      <data key="exam_type">选择题、材料分析题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修4 第二课</data>
    </node>
    <node id="P_K4_2_3">
      <data key="name">一切从实际出发实事求是</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">探索世界与追求真理</data>
      <data key="difficulty">3</data>
      <data key="description">物质决定意识要求我们一切从实际出发，实事求是，这是马克思主义的根本观点。</data>
      <data key="keywords">从实际出发,实事求是,物质决定意识</data>
      <data key="exam_type">材料分析题、辨析题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修4 第二课</data>
    </node>
    <node id="P_K4_2_4">
      <data key="name">实践的含义与特点</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">探索世界与追求真理</data>
      <data key="difficulty">3</data>
      <data key="description">实践是人们改造客观世界的物质性活动，具有客观物质性、主观能动性、社会历史性。</data>
      <data key="keywords">实践,改造客观世界,客观物质性,社会历史性</data>
      <data key="exam_type">选择题、简答题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修4 第三课</data>
    </node>
