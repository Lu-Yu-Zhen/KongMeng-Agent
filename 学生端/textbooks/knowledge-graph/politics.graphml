    <node id="P_K4_4_3">
      <data key="name">人民群众是历史的创造者</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">哲学与文化</data>
      <data key="chapter">社会历史与人生价值</data>
      <data key="difficulty">3</data>
      <data key="description">人民群众是社会物质财富和精神财富的创造者，是社会变革的决定力量；坚持群众观点群众路线。</data>
