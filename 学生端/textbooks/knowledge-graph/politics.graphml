      <data key="subject">政治</data>
      <data key="module">中国特色社会主义</data>
      <data key="chapter">新时代中国特色社会主义与中国梦</data>
      <data key="difficulty">3</data>
      <data key="description">在全面建成小康社会基础上，分两步走到本世纪中叶建成富强民主文明和谐美丽的社会主义现代化强国。</data>
      <data key="keywords">两个一百年,两步走,社会主义现代化强国</data>
