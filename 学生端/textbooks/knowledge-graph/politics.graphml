    <node id="P_K1_2_3">
      <data key="name">中国特色社会主义道路的开辟</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">中国特色社会主义</data>
      <data key="chapter">中国特色社会主义的开创与发展</data>
      <data key="difficulty">3</data>
      <data key="description">以邓小平理论为指导开辟中国特色社会主义道路，回答了什么是社会主义、怎样建设社会主义。</data>
      <data key="keywords">中国特色社会主义道路,邓小平理论</data>
