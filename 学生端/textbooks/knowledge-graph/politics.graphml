      <data key="subject">政治</data>
      <data key="module">法律生活与逻辑思维</data>
      <data key="chapter">科学思维与形式逻辑</data>
      <data key="difficulty">4</data>
      <data key="description">演绎推理从一般到个别（如三段论），归纳推理从个别到一般（完全归纳与不完全归纳）。</data>
      <data key="keywords">演绎推理,三段论,归纳推理,完全不完全归纳</data>
      <data key="exam_type">选择题、案例分析题</data>
      <data key="importance">5</data>
      <data key="textbook_source">选必3 第二单元</data>
    </node>
