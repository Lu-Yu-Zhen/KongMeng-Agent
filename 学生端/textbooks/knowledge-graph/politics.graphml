    <node id="P_K1_1_1">
      <data key="name">空想社会主义的代表与局限</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">中国特色社会主义</data>
      <data key="chapter">社会主义从空想到科学到现实</data>
      <data key="difficulty">2</data>
      <data key="description">以圣西门、傅立叶、欧文为代表的空想社会主义对资本主义进行批判并构想了未来社会，但未揭示资本主义根本矛盾，未找到变革社会的现实力量。</data>
      <data key="keywords">空想社会主义,圣西门,傅立叶,欧文,历史局限</data>
      <data key="exam_type">选择题、材料分析题</data>
      <data key="importance">3</data>
      <data key="textbook_source">必修1 第一课</data>
    </node>
    <node id="P_K1_1_2">
      <data key="name">科学社会主义的诞生</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">中国特色社会主义</data>
      <data key="chapter">社会主义从空想到科学到现实</data>
      <data key="difficulty">3</data>
      <data key="description">1848年《共产党宣言》发表标志科学社会主义诞生；其两大理论基石是唯物史观和剩余价值学说。</data>
      <data key="keywords">共产党宣言,唯物史观,剩余价值学说,科学社会主义</data>
      <data key="exam_type">选择题、简答题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第一课</data>
    </node>
    <node id="P_K1_1_3">
      <data key="name">科学社会主义从理论到现实</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">中国特色社会主义</data>
      <data key="chapter">社会主义从空想到科学到现实</data>
      <data key="difficulty">3</data>
      <data key="description">1917年俄国十月革命把马克思主义关于无产阶级革命的理论变为现实，建立世界上第一个社会主义国家。</data>
      <data key="keywords">十月革命,理论到现实,第一个社会主义国家</data>
      <data key="exam_type">选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第一课</data>
    </node>
    <node id="P_K1_1_4">
      <data key="name">社会主义从一国到多国</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">政治</data>
      <data key="module">中国特色社会主义</data>
      <data key="chapter">社会主义从空想到科学到现实</data>
      <data key="difficulty">2</data>
      <data key="description">二战后社会主义越出一国范围形成阵营，历史性飞跃体现了社会主义发展的曲折性与前进性。</data>
      <data key="keywords">一国到多国,社会主义阵营,曲折前进</data>
      <data key="exam_type">选择题</data>
      <data key="importance">2</data>
      <data key="textbook_source">必修1 第一课</data>
    </node>
    <node id="P_K1_2_1">
      <data key="name">新民主主义革命向社会主义过渡</data>
