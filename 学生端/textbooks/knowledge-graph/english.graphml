      <data key="module">必修第一册</data>
      <data key="chapter">Teenage Life</data>
      <data key="difficulty">3</data>
      <data key="description">掌握略读(skimming)技巧:快速浏览标题、首尾段、每段首句，在短时间内获取文章主旨大意和中心思想。</data>
      <data key="keywords">略读,skimming,主旨大意,标题,首尾段,中心思想</data>
