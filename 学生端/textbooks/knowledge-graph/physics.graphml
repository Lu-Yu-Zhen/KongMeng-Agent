    <node id="K5">
      <data key="name">匀变速直线运动的速度与时间关系</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">物理</data>
      <data key="module">必修第一册(力学基础)</data>
      <data key="chapter">匀变速直线运动的研究</data>
      <data key="difficulty">3</data>
      <data key="description">掌握匀变速直线运动的速度公式v=v0+at,理解v-t图象及其斜率意义。</data>
      <data key="keywords">速度公式,v-t图象,匀变速,斜率</data>
      <data key="exam_type">计算题,图象分析</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修第一册</data>
    </node>
    <node id="K6">
      <data key="name">匀变速直线运动的位移与时间关系</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">物理</data>
      <data key="module">必修第一册(力学基础)</data>
      <data key="chapter">匀变速直线运动的研究</data>
      <data key="difficulty">4</data>
