      <data key="name">地球存在生命的条件</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">宇宙中的地球</data>
      <data key="difficulty">3</data>
      <data key="description">外部条件是太阳光照稳定、行星各行其道互不干扰；自身条件是适宜温度、液态水、适合呼吸的大气。</data>
      <data key="keywords">生命条件,外部条件,自身条件,适宜温度液态水大气</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第一章</data>
    </node>
    <node id="G_K1_2_1">
      <data key="name">大气组成与垂直分层</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地球上的大气</data>
      <data key="difficulty">3</data>
      <data key="description">干洁空气、水汽、固体杂质组成大气；垂直分对流层（气温递减、对流）、平流层（升温、航空）、高层大气。</data>
      <data key="keywords">大气组成,对流层,平流层,高层大气,气温垂直变化</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第二章</data>
    </node>
    <node id="G_K1_2_2">
      <data key="name">大气的受热过程</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地球上的大气</data>
      <data key="difficulty">4</data>
      <data key="description">太阳短波辐射经大气削弱到达地面，地面增温后以长波辐射加热大气，大气逆辐射对地面起保温作用。</data>
      <data key="keywords">受热过程,短波辐射,长波辐射,地面辐射,大气逆辐射,保温作用</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修1 第二章</data>
    </node>
    <node id="G_K1_2_3">
      <data key="name">热力环流</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地球上的大气</data>
      <data key="difficulty">4</data>
      <data key="description">地面冷热不均引起大气上升下沉运动，形成同一水平面气压差异，进而形成热力环流，是大气运动最简单形式。</data>
      <data key="keywords">热力环流,冷热不均,上升下沉,气压差异,大气运动</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修1 第二章</data>
    </node>
    <node id="G_K1_2_4">
      <data key="name">大气的水平运动——风</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地球上的大气</data>
      <data key="difficulty">4</data>
      <data key="description">水平气压梯度力是风形成的直接原因；高空风受气压梯度力与地转偏向力影响，近地面风还受摩擦力影响。</data>
      <data key="keywords">风,水平气压梯度力,地转偏向力,摩擦力,风向</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第二章</data>
    </node>
    <node id="G_K1_3_1">
      <data key="name">水循环</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地球上的水</data>
      <data key="difficulty">4</data>
      <data key="description">包括蒸发、水汽输送、降水、地表径流、下渗、地下径流等环节；分海上内循环、陆地内循环、海陆间循环，意义在于维持全球水量平衡、塑造地表形态。</data>
      <data key="keywords">水循环,环节,海陆间循环,水量平衡,塑造地表</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修1 第三章</data>
    </node>
    <node id="G_K1_3_2">
      <data key="name">海水的性质</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地球上的水</data>
      <data key="difficulty">3</data>
      <data key="description">海水温度随纬度升高而降低、随深度增加而降低；盐度以副热带海区最高；密度随温度降低盐度升高而增大。</data>
      <data key="keywords">海水温度,海水盐度,海水密度,分布规律</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第三章</data>
    </node>
    <node id="G_K1_3_3">
      <data key="name">海水的运动</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地球上的水</data>
      <data key="difficulty">3</data>
      <data key="description">海水运动形式有波浪、潮汐、洋流，对航运、海岸地貌、海洋生物有重要影响。</data>
      <data key="keywords">海水运动,波浪,潮汐,洋流</data>
      <data key="exam_type">选择题</data>
      <data key="importance">3</data>
      <data key="textbook_source">必修1 第三章</data>
    </node>
    <node id="G_K1_4_1">
      <data key="name">常见地貌类型</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地貌</data>
      <data key="difficulty">3</data>
      <data key="description">喀斯特地貌、河流地貌、风成地貌、海岸地貌等的成因与形态特征。</data>
      <data key="keywords">喀斯特地貌,河流地貌,风成地貌,海岸地貌</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第四章</data>
    </node>
    <node id="G_K1_4_2">
      <data key="name">河流地貌的发育</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地貌</data>
      <data key="difficulty">4</data>
      <data key="description">上游侵蚀形成V型谷，中游侧蚀拓宽河道，下游堆积形成冲积平原、三角洲。</data>
      <data key="keywords">河流地貌,V型谷,冲积平原,三角洲,侵蚀堆积</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修1 第四章</data>
    </node>
    <node id="G_K1_4_3">
      <data key="name">地貌观察与等高线</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">地貌</data>
      <data key="difficulty">3</data>
      <data key="description">通过等高线地形图判断山顶山脊山谷鞍部陡崖，观察地貌的坡度、走向与组合。</data>
      <data key="keywords">等高线,山顶山脊山谷,鞍部陡崖,地貌观察</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第四章</data>
    </node>
    <node id="G_K1_5_1">
      <data key="name">主要植被类型与环境</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">植被与土壤</data>
      <data key="difficulty">3</data>
      <data key="description">森林、草原、荒漠等植被类型与气候水分条件相适应，植被是自然环境的一面镜子。</data>
      <data key="keywords">植被,森林草原荒漠,气候水分,自然环境镜子</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">3</data>
      <data key="textbook_source">必修1 第五章</data>
    </node>
    <node id="G_K1_5_2">
      <data key="name">土壤的组成与形成因素</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">植被与土壤</data>
      <data key="difficulty">4</data>
      <data key="description">土壤由矿物质、有机质、水分、空气组成；成土母质、气候、生物、地形、时间是其形成因素。</data>
      <data key="keywords">土壤组成,矿物质有机质,成土母质,成土因素</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第五章</data>
    </node>
    <node id="G_K1_5_3">
      <data key="name">土壤剖面与质地</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">植被与土壤</data>
      <data key="difficulty">2</data>
      <data key="description">自然土壤剖面分枯枝落叶层、腐殖质层、淋溶层、淀积层、母质层；土壤质地分砂土、壤土、黏土。</data>
      <data key="keywords">土壤剖面,腐殖质层,淋溶淀积,土壤质地,砂土壤土黏土</data>
      <data key="exam_type">选择题</data>
      <data key="importance">3</data>
      <data key="textbook_source">必修1 第五章</data>
    </node>
    <node id="G_K1_6_1">
