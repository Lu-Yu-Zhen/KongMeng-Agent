      <data key="chapter">自然灾害</data>
      <data key="difficulty">2</data>
      <data key="description">通过遥感等监测手段、工程与非工程防御措施及灾后救援减轻灾害损失。</data>
      <data key="keywords">灾害监测,遥感,防御措施,灾后救援</data>
      <data key="exam_type">选择题、简答题</data>
      <data key="importance">3</data>
