      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第二册——人文地理</data>
      <data key="chapter">乡村和城镇</data>
      <data key="difficulty">4</data>
      <data key="description">城镇化是人口向城镇集聚和乡村变城镇的过程；带来环境污染、交通拥挤、住房紧张等问题。</data>
      <data key="keywords">城镇化,人口集聚,环境污染,交通拥挤,城市化问题</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2 第二章</data>
    </node>
    <node id="G_K2_2_3">
      <data key="name">地域文化与城乡景观</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第二册——人文地理</data>
      <data key="chapter">乡村和城镇</data>
      <data key="difficulty">2</data>
      <data key="description">地域文化影响建筑风格、空间布局，形成各具特色的城乡景观。</data>
      <data key="keywords">地域文化,建筑风格,城乡景观</data>
      <data key="exam_type">选择题</data>
      <data key="importance">3</data>
      <data key="textbook_source">必修2 第二章</data>
    </node>
    <node id="G_K2_3_1">
      <data key="name">农业区位因素</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第二册——人文地理</data>
      <data key="chapter">产业区位因素</data>
      <data key="difficulty">4</data>
      <data key="description">自然因素（气候、地形、水源、土壤）和社会经济因素（市场、交通、劳动力、政策、技术）影响农业生产。</data>
      <data key="keywords">农业区位,自然因素,社会经济因素,农业地域类型</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2 第三章</data>
