    </node>
    <node id="G_K2_1_1">
      <data key="name">人口分布的影响因素</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第二册——人文地理</data>
      <data key="chapter">人口</data>
      <data key="difficulty">3</data>
      <data key="description">自然因素（气候、地形、水源、土壤）和社会经济因素（经济、交通、历史）共同影响人口分布。</data>
      <data key="keywords">人口分布,自然因素,社会经济因素</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修2 第一章</data>
    </node>
    <node id="G_K2_1_2">
      <data key="name">人口迁移及其影响因素</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第二册——人文地理</data>
      <data key="chapter">人口</data>
      <data key="difficulty">4</data>
      <data key="description">人口迁移受推力（经济落后、灾害、战争）和拉力（经济发达、资源、政策）影响。</data>
      <data key="keywords">人口迁移,推力拉力,影响因素</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2 第一章</data>
    </node>
    <node id="G_K2_1_3">
      <data key="name">人口数量变化</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第二册——人文地理</data>
      <data key="chapter">人口</data>
      <data key="difficulty">3</data>
      <data key="description">人口数量变化由自然增长（出生率减死亡率）和机械增长（迁移）决定；人口增长模式分原始、传统、现代型。</data>
      <data key="keywords">人口数量变化,自然增长,机械增长,人口增长模式</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修2 第一章</data>
    </node>
    <node id="G_K2_1_4">
      <data key="name">人口容量</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第二册——人文地理</data>
      <data key="chapter">人口</data>
      <data key="difficulty">4</data>
      <data key="description">环境承载力决定环境人口容量，合理人口容量是使人类活动与环境协调的最适宜人口数。</data>
      <data key="keywords">人口容量,环境承载力,合理人口容量</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修2 第一章</data>
    </node>
    <node id="G_K2_2_1">
      <data key="name">城乡空间结构</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第二册——人文地理</data>
      <data key="chapter">乡村和城镇</data>
      <data key="difficulty">4</data>
      <data key="description">城镇分住宅区、商业区、工业区等功能区，受地租、交通通达度、知名度等因素影响分布。</data>
      <data key="keywords">城乡空间结构,住宅区商业区工业区,地租,功能分区</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">必修2 第二章</data>
    </node>
    <node id="G_K2_2_2">
