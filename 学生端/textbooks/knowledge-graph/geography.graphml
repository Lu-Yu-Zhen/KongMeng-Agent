    <node id="G_K4_1_2">
      <data key="name">区域发展阶段与产业结构</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">选择性必修2 区域发展</data>
      <data key="chapter">区域与区域发展</data>
      <data key="difficulty">3</data>
      <data key="description">区域经历初期、成长、转型、衰退等阶段，产业结构由第一产业向二三产业演进。</data>
      <data key="keywords">区域发展阶段,初期成长转型,产业结构演进</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选必2 第一章</data>
    </node>
    <node id="G_K4_1_3">
      <data key="name">区域发展的优势与限制因素</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">选择性必修2 区域发展</data>
      <data key="chapter">区域与区域发展</data>
      <data key="difficulty">2</data>
      <data key="description">区位条件、资源禀赋是优势，生态环境脆弱、基础设施薄弱等是限制因素。</data>
      <data key="keywords">区域发展,区位条件,资源禀赋,优势与限制</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">3</data>
      <data key="textbook_source">选必2 第一章</data>
    </node>
    <node id="G_K4_2_1">
      <data key="name">生态脆弱区的成因与特征</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">选择性必修2 区域发展</data>
      <data key="chapter">生态脆弱区的治理</data>
      <data key="difficulty">3</data>
      <data key="description">生态脆弱区生态环境抗干扰能力弱，自然条件恶劣与人类不合理活动叠加易退化。</data>
      <data key="keywords">生态脆弱区,抗干扰能力弱,生态退化,自然与人为叠加</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选必2 第二章</data>
    </node>
    <node id="G_K4_2_2">
      <data key="name">黄土高原水土流失治理</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">选择性必修2 区域发展</data>
      <data key="chapter">生态脆弱区的治理</data>
      <data key="difficulty">4</data>
      <data key="description">黄土高原水土流失由土质疏松、降水集中、植被破坏导致，通过工程（打坝淤地）、生物（植树种草）、农业技术措施综合治理。</data>
      <data key="keywords">黄土高原,水土流失,打坝淤地,植树种草,综合治理</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">选必2 第二章</data>
    </node>
    <node id="G_K4_2_3">
      <data key="name">荒漠化的治理</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">选择性必修2 区域发展</data>
      <data key="chapter">生态脆弱区的治理</data>
      <data key="difficulty">4</data>
      <data key="description">西北地区荒漠化由气候干旱、过度放牧开垦引起，通过合理利用水资源、设置沙障、恢复植被治理。</data>
      <data key="keywords">荒漠化,西北地区,过度放牧开垦,沙障,恢复植被</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">5</data>
      <data key="textbook_source">选必2 第二章</data>
    </node>
    <node id="G_K4_2_4">
      <data key="name">湿地的开发与保护</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">选择性必修2 区域发展</data>
      <data key="chapter">生态脆弱区的治理</data>
      <data key="difficulty">3</data>
      <data key="description">湿地具有蓄洪防旱、调节气候、净化水质等功能，围垦污染导致退化，需退田还湿保护。</data>
      <data key="keywords">湿地,蓄洪防旱,调节气候,退化,退田还湿</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选必2 第二章</data>
    </node>
    <node id="G_K4_3_1">
      <data key="name">资源枯竭型城市转型</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">选择性必修2 区域发展</data>
      <data key="chapter">资源枯竭型城市转型</data>
      <data key="difficulty">3</data>
      <data key="description">以大庆（石油）、阜新（煤炭）为例，资源枯竭后通过培育新产业、发展接续产业实现转型。</data>
      <data key="keywords">资源枯竭型城市,大庆,阜新,接续产业,转型</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">选必2 第三章</data>
    </node>
