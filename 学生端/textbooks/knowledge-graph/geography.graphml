    <node id="G_K2_3_2">
      <data key="name">工业区位因素</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第二册——人文地理</data>
      <data key="chapter">产业区位因素</data>
      <data key="difficulty">4</data>
      <data key="description">原料、动力、劳动力、市场、交通、土地、水源、政策等影响工业区位选择，主导因素决定工业类型。</data>
      <data key="keywords">工业区位,原料动力,市场交通,主导因素,工业地域</data>
