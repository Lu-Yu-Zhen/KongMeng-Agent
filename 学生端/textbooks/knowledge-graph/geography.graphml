      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">自然灾害</data>
      <data key="difficulty">4</data>
      <data key="description">洪涝、干旱、台风、寒潮等气象灾害的成因、时空分布与危害。</data>
      <data key="keywords">气象灾害,洪涝干旱台风寒潮,成因分布危害</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第六章</data>
    </node>
    <node id="G_K1_6_2">
      <data key="name">地质灾害</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">自然灾害</data>
      <data key="difficulty">4</data>
      <data key="description">地震、滑坡、泥石流等地质灾害的成因、分布与危害，常与气象灾害链发。</data>
      <data key="keywords">地质灾害,地震滑坡泥石流,成因分布,灾害链</data>
      <data key="exam_type">综合题、选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第六章</data>
    </node>
