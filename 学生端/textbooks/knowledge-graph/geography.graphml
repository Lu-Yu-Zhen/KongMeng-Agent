    <node id="G_K1_1_1">
      <data key="name">天体与天体系统</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">宇宙中的地球</data>
      <data key="difficulty">2</data>
      <data key="description">宇宙中恒星、行星、星云等为天体；天体相互吸引相互绕转形成地月系、太阳系、银河系等天体系统。</data>
      <data key="keywords">天体,恒星行星星云,天体系统,地月系太阳系银河系</data>
      <data key="exam_type">选择题</data>
      <data key="importance">3</data>
      <data key="textbook_source">必修1 第一章</data>
    </node>
    <node id="G_K1_1_2">
      <data key="name">太阳辐射及其影响</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">宇宙中的地球</data>
      <data key="difficulty">3</data>
      <data key="description">太阳辐射是地球大气运动水循环和生物活动的主要能量来源，维持地表温度。</data>
      <data key="keywords">太阳辐射,能量来源,大气运动,水循环</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第一章</data>
    </node>
    <node id="G_K1_1_3">
      <data key="name">太阳活动对地球的影响</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">宇宙中的地球</data>
      <data key="difficulty">3</data>
      <data key="description">黑子耀斑等太阳活动影响无线电短波通信、干扰磁场、产生极光，与气候有一定相关性。</data>
      <data key="keywords">太阳活动,黑子,耀斑,无线电通信,极光</data>
      <data key="exam_type">选择题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第一章</data>
    </node>
    <node id="G_K1_1_4">
      <data key="name">地球的圈层结构</data>
      <data key="type">KnowledgePoint</data>
      <data key="subject">地理</data>
      <data key="module">必修第一册——自然地理基础</data>
      <data key="chapter">宇宙中的地球</data>
      <data key="difficulty">3</data>
      <data key="description">内部圈层分地壳、地幔、地核（以莫霍面、古登堡面为界）；外部圈层为大气圈、水圈、生物圈。</data>
      <data key="keywords">圈层结构,地壳地幔地核,莫霍面古登堡面,大气水生物圈</data>
      <data key="exam_type">选择题、综合题</data>
      <data key="importance">4</data>
      <data key="textbook_source">必修1 第一章</data>
    </node>
